{
  "name": "perdiction-market",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:deploy": "bun run --cwd packages/db db:deploy",
    "db:studio": "bun run --cwd packages/db db:studio",
    "db:seed": "bun run --cwd apps/backend db:seed",
    "db:up": "docker compose up -d postgres"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.10",
    "node": ">=20"
  },
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}

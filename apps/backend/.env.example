# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated list of allowed browser origins ("*" allows any).
CORS_ORIGINS=http://localhost:5173
# Number of reverse-proxy hops to trust for client IPs (rate limiting).
TRUST_PROXY=0

# --- Database ----------------------------------------------------------------
# Falls back to packages/db/.env when unset.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mirage?schema=public"

# --- Auth (Supabase Web3 / Solana) -------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Service-role secret; never expose to the browser.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Local development only: authenticate requests via the `x-dev-address` header
# instead of Supabase. Refused when NODE_ENV=production.
AUTH_DEV_BYPASS=0

# --- Admin -------------------------------------------------------------------
# Enables /api/admin/* (create and resolve markets) when set. Min 32 chars.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# --- Economy (integer cents) ---------------------------------------------------
STARTING_BALANCE_CENTS=1000
DAILY_CLAIM_CENTS=10000

# Rate limiting defaults to on outside tests.
# RATE_LIMIT_ENABLED=1

# --- Tests -------------------------------------------------------------------
# Integration tests only run when this is set. Use a disposable database.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mirage_test?schema=public"

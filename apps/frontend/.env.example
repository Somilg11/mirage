# Base URL of the backend API. Defaults to "/api", which the Vite dev server proxies to the backend.
# For production builds set it to the deployed backend, e.g. https://api.example.com/api
VITE_API_URL=/api

# Supabase project used for Solana Web3 sign-in (public anon key — safe to expose to the browser).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Dev server only: where /api requests are proxied to.
DEV_API_PROXY_TARGET=http://localhost:3000

{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "db:generate": {
      "cache": false,
      "outputs": ["generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "lint": {
      "dependsOn": ["^db:generate"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "^db:generate"]
    },
    "test": {
      "dependsOn": ["^db:generate"],
      "env": ["TEST_DATABASE_URL", "TEST_CONCURRENCY"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    }
  }
}
